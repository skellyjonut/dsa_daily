#include<bits/stdc++.h>
using namespace std;

int main(){
    int t;
    long long n,k,a;
    cin >> t;
    while(t--){
        cin >> n >> k;
        vector<int> res(n);
        for(int i = 0; i < n;i++){
            cin >> a;
            int m = a%(k+1);
            res[i] = a+m*k;
        }
        for(auto i: res){
            cout << i << " ";
        }

    }
}